rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função auxiliar para verificar autenticação
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Função para verificar se o usuário é o dono do registro
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // BLOQUEIO TOTAL POR PADRÃO: Qualquer coleção não especificada é negada
    match /{document=**} {
      allow read, write: if false;
    }

    // ESTRUTURA 1: Documentos aninhados por usuário (/users/{userId}/...)
    // Permite que o usuário acerte apenas seus próprios dados (listas, compras, precos, notas)
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // ESTRUTURA 2: Coleções na raiz com campo `userId`
    // Permite consultas filtradas por userId (ex: where("userId", "==", auth.uid))
    match /listas/{listaId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /lista_itens/{itemId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /precos/{precoId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /notas/{notaId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
